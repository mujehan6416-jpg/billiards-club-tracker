rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.active == true;
    }

    // ── split Firestore 구조(보안 4단계) 전용 helper ────────────────────
    // 주의: isAdmin()과 달리 exists()를 먼저 확인한다 — memberLinks 문서가
    // 없는(=연결 안 된) 사용자가 대부분일 것이므로, 그 경우 get().data 접근으로
    // Null value 평가 오류를 만들지 않고 곧바로 false로 판정한다.
    function isSignedIn() {
      return request.auth != null;
    }

    function hasActiveMemberLink(clubId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/clubs/$(clubId)/memberLinks/$(request.auth.uid))
        && get(
          /databases/$(database)/documents/clubs/$(clubId)/memberLinks/$(request.auth.uid)
        ).data.active == true;
    }

    // ── split write(보안 7단계) 전용 helper ──────────────────────────────
    // 반드시 hasActiveMemberLink(clubId)가 이미 true로 확인된 뒤에만 부른다(연결 문서가
    // 있다는 전제 하에 안전하게 get()한다) — 그렇지 않으면 위 hasActiveMemberLink와 같은
    // 이유로 Null value 평가 오류가 날 수 있다.
    function linkedMemberId(clubId) {
      return get(
        /databases/$(database)/documents/clubs/$(clubId)/memberLinks/$(request.auth.uid)
      ).data.memberId;
    }

    // 이 세션이 번개모임인지. 게임 하위 컬렉션 규칙에서 부모 세션 문서를 확인할 때 쓴다.
    function isFlashSession(clubId, sessionId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)/sessions/$(sessionId)).data.type == 'flash';
    }

    // 이 회원이 이 경기의 참가자(A 또는 B) 본인인지.
    function isGameParticipant(clubId, playerAId, playerBId) {
      return hasActiveMemberLink(clubId) && linkedMemberId(clubId) in [playerAId, playerBId];
    }

    // ── legacy 단일 문서 (공개 접근 폐쇄) ──────────────────────────────
    // 예전에는 앱 데이터 전체가 이 문서 하나(clubs/skkubc)에 JSON으로 들어 있었고, 규칙도
    // `if true`라 인증 없이 누구나 읽고 쓸 수 있었다. split 구조로 완전히 전환하고(회원·모임·
    // 경기·회계·설정 모두 하위 컬렉션으로 이전) 정상 운영 경로에서 이 문서를 쓰는 곳이 전부
    // 없어져서, 이제 공개 접근을 닫는다.
    //
    // 문서 자체는 지우지 않는다 — USE_SPLIT_FIRESTORE를 false로 되돌리는 rollback 배포를
    // 하게 되면 그때 이 문서의 내용이 다시 필요하다. 그 경우에는 이 규칙도 함께 되돌려야 한다.
    //
    // 이 match는 clubs/skkubc "문서 하나"만 가리킨다. Firestore 규칙은 문서 match가 하위
    // 컬렉션으로 전파되지 않으므로, 아래의 settlements·linkRequests·memberLinks·members·
    // memberIndex·sessions·games·ledger·config 규칙은 이 변경에 전혀 영향을 받지 않는다.
    match /clubs/skkubc {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid;
      allow write: if false;
    }

    match /clubs/skkubc/settlements/{settlementId} {
      allow read, write: if isAdmin();
    }

    // ── 회원-기기 연결 (보안 강화 2단계) ───────────────────────────────
    // 기존 clubs/skkubc 문서 규칙은 그대로 두고, 새 경로만 추가로 연다.
    // 이번 단계에서는 이 연결이 기존 데이터 접근 권한에 아직 쓰이지 않는다(기반만 마련).

    // 연결 요청: 회원이 자기 UID 문서 하나만 만들 수 있다.
    match /clubs/{clubId}/linkRequests/{firebaseUid} {
      // 자기 요청만 확인할 수 있고, 전체 목록은 관리자만 볼 수 있다.
      allow get: if request.auth != null && request.auth.uid == firebaseUid;
      allow list: if isAdmin();

      // 요청자가 쓸 수 있는 값은 memberId·requestedAt 두 개뿐이다.
      // role·active·승인정보를 끼워 넣어 스스로 관리자가 되는 것을 막는다.
      allow create: if request.auth != null
        && request.auth.uid == firebaseUid
        && request.resource.data.keys().hasOnly(['memberId', 'requestedAt'])
        && request.resource.data.memberId is string
        && request.resource.data.memberId.size() > 0
        && request.resource.data.memberId.size() < 200
        && request.resource.data.requestedAt is string;

      // 만든 요청을 나중에 다른 회원으로 바꿔치기할 수 없다 — 취소하고 다시 요청해야 한다.
      allow update: if false;

      // 본인은 취소할 수 있고, 관리자는 승인·거절 처리 과정에서 지운다.
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == firebaseUid);
    }

    // 연결 기록: 만들고 바꾸는 것은 Firebase 관리자만 할 수 있다.
    match /clubs/{clubId}/memberLinks/{firebaseUid} {
      allow get: if request.auth != null && request.auth.uid == firebaseUid;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── split Firestore 구조 (보안 4단계, 운영 전환 완료) ────────────────
    // legacy clubs/{clubId} 공개 문서와 완전히 별개로, 새 구조는 처음부터
    // "연결된 활성 회원 = 조회만, 관리자 = 전체" 최소 권한으로 설계한다.
    //
    // 주의: isAdmin()은 top-level admins/{uid} 기반 전역 관리자 판정이라, 활성 관리자는
    // 아래 모든 clubId의 split 데이터에 접근할 수 있다(club별 관리자 분리가 아직 없음).
    // 이는 향후 멀티클럽 권한 모델에서 별도로 다룬다(tests/rules/splitMultiClubIsolation.rules.test.ts 참고).

    match /clubs/{clubId}/config/main {
      allow get: if hasActiveMemberLink(clubId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /clubs/{clubId}/members/{memberId} {
      allow get, list: if hasActiveMemberLink(clubId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── 이름 찾기 목록 (최종 보안 마감 단계) ───────────────────────────
    // 아직 이 클럽 어디에도 연결되지 않은 새 기기는 위 members를 전혀 읽을 수 없다
    // (hasActiveMemberLink도, isAdmin도 아니므로) — 그러면 "내가 누구인지" 고를 방법이
    // 없어 연결 요청(linkRequests) 자체를 못 만든다. 그래서 이 컬렉션만 "로그인만 됐으면
    // (연결·관리자 여부와 무관하게) 누구나 read 가능"으로 살짝 더 열어 둔다 — 대신 담는
    // 내용을 이름·활성 여부·구분정보로만 최소화한다(handicap 등 실적 데이터, password는
    // 절대 넣지 않는다 — src/types/splitFirestore.ts의 MemberIndexEntry 참고).
    match /clubs/{clubId}/memberIndex/{memberId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /clubs/{clubId}/memberPrivate/{memberId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /clubs/{clubId}/sessions/{sessionId} {
      allow get, list: if hasActiveMemberLink(clubId) || isAdmin();

      // 생성: 관리자는 제한 없음(정기모임 포함). 회원은 번개모임만, 그것도 정해진 필드로만
      // 만들 수 있다 — 특히 approved는 반드시 false로 강제한다(자기 번개모임을 스스로
      // "정규 통계 반영" 상태로 만들 수 없게). 실제 앱(MeetingTab)도 회원에게는 번개모임
      // 생성만 허용하고(flashOnly=!isAdmin), createSession()이 항상 approved:false로 만든다.
      allow create: if isAdmin() || (
        hasActiveMemberLink(clubId)
        && request.resource.data.id == sessionId
        && request.resource.data.keys().hasOnly(['id', 'date', 'type', 'attendeeIds', 'approved'])
        && request.resource.data.type == 'flash'
        && request.resource.data.approved == false
        && request.resource.data.date is string
        && request.resource.data.attendeeIds is list
      );

      // 수정: 관리자는 제한 없음(승인·대진 게시·라운드 참가자 지정·삭제 대체 등 전부 포함).
      // 회원은 "이미 번개모임인" 세션의 attendeeIds(참석자 명단) 한 필드만 바꿀 수 있다 —
      // 실제 앱에서 회원이 canEdit(=isFlash)로 직접 바꾸는 값은 참석자 편집(AttendeeEditor)
      // 뿐이다. 대진표 게시·라운드 참가자 지정은 화면 자체가 정기모임(!isFlash)에서만
      // 나타나 admin 전용이고, 번개모임 승인(approved)과 모임 삭제도 화면상 admin 전용
      // 버튼이다. type을 바꿔 정기모임으로 둔갑시키거나 approved를 스스로 켜는 것도
      // diff().hasOnly(['attendeeIds'])로 막힌다.
      allow update: if isAdmin() || (
        hasActiveMemberLink(clubId)
        && resource.data.type == 'flash'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds'])
        && request.resource.data.attendeeIds is list
      );

      // 삭제: 관리자 전용. 실제 앱에서 "모임 삭제" 버튼은 번개모임이라도 isAdmin일 때만
      // 보인다(canEdit만으로는 노출되지 않는다) — 회원에게는 애초에 필요 없는 권한이다.
      allow delete: if isAdmin();

      match /games/{gameId} {
        allow get, list: if hasActiveMemberLink(clubId) || isAdmin();

        // 생성: 관리자는 제한 없음. 회원은 항상 pending:true로만, 정해진 필드로만 만들 수
        // 있다(관리자 확인 전 확정 통계에 반영되지 않게, winnerId 같은 관리자 전용 필드는
        // 아예 끼워 넣을 수 없게) — 정기모임이면 본인이 참가자인 경기만, 번개모임이면
        // (경기 입력을 대신 해주는 경우가 흔해) 연결된 활성 회원이면 누구나 만들 수 있다.
        allow create: if isAdmin() || (
          hasActiveMemberLink(clubId)
          && request.resource.data.id == gameId
          && request.resource.data.keys().hasOnly(
            ['id', 'playerAId', 'playerBId', 'handicapA', 'handicapB', 'scoreA', 'scoreB', 'endType', 'playedAt', 'round', 'pending']
          )
          && request.resource.data.playerAId is string
          && request.resource.data.playerBId is string
          && request.resource.data.playerAId != request.resource.data.playerBId
          && request.resource.data.scoreA is number && request.resource.data.scoreA >= 0
          && request.resource.data.scoreB is number && request.resource.data.scoreB >= 0
          && request.resource.data.handicapA is number && request.resource.data.handicapA > 0
          && request.resource.data.handicapB is number && request.resource.data.handicapB > 0
          && request.resource.data.endType in ['cleared', 'time']
          && request.resource.data.pending == true
          && (
            isFlashSession(clubId, sessionId)
            || isGameParticipant(clubId, request.resource.data.playerAId, request.resource.data.playerBId)
          )
        );

        // 수정: 관리자는 제한 없음(확인 완료·수정 요청 처리 포함, winnerId 삭제 등). 회원은
        // 본인이 참가자이면서 그 경기가 "아직 관리자 확인 전(pending)"일 때만, 점수 재제출과
        // 정확히 같은 필드만 바꿀 수 있다 — resource.data.pending == true를 반드시 확인해야
        // 한다, 그렇지 않으면 이미 관리자가 확인 완료(pending:false)한 경기까지 참가자가
        // 다시 "제출 대기" 상태로 되돌리고 점수를 바꿔치기할 수 있다(관리자 확정 기록 보호
        // 무력화). 재제출은 항상 다시 pending 확인 대기 상태로 돌아가야 한다.
        allow update: if isAdmin() || (
          isGameParticipant(clubId, resource.data.playerAId, resource.data.playerBId)
          && resource.data.pending == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreA', 'scoreB', 'endType', 'pending', 'revisionRequested'])
          && request.resource.data.pending == true
          && request.resource.data.revisionRequested == false
        );

        // 삭제: 관리자는 제한 없음. 회원은 "본인이 참가자"이면서 "아직 관리자 확인 전
        // (pending)"인 경기만 지울 수 있다 — 실제 앱은 번개모임에서 canEdit(=isFlash)이면
        // 참가자가 아니어도, 이미 확정된 기록도 지울 수 있지만, 최소 권한 원칙에 따라
        // 여기서는 "본인 참가 + 미확정" 경기의 자가 정정만 허용하고 관리자가 이미 확인한
        // 기록과 남의 기록은 보호한다.
        allow delete: if isAdmin() || (
          isGameParticipant(clubId, resource.data.playerAId, resource.data.playerBId)
          && resource.data.pending == true
        );
      }
    }

    match /clubs/{clubId}/ledger/{recordId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── 대회 토너먼트 ────────────────────────────────────────────────
    // 기존 일반 경기(sessions/games)와 완전히 분리된 독립 기능이다. 위의 어떤 규칙도
    // 바꾸지 않고 새 경로만 추가한다.
    //
    // 회원이 서버에서 직접 할 수 있는 일은 딱 세 가지뿐이다.
    //   ① 본인이 나온 경기의 점수 입력   ② 상대가 넣은 결과 확인   ③ 수정 요청
    // 공식 승패 확정, 다음 라운드 배치, 대진 생성·취소, 추첨 매핑은 전부 관리자만 할 수 있다.

    match /clubs/{clubId}/tournaments/{tournamentId} {
      allow get, list: if hasActiveMemberLink(clubId) || isAdmin();
      allow create, update, delete: if isAdmin();

      // 참가자 명단. 이번 단계에서는 회원 쓰기를 열지 않는다 — 참가/불참 화면이 아직 없어서,
      // 미리 열어 두면 실제로 필요한 것보다 넓은 권한이 그대로 굳어진다. 화면이 생길 때
      // "그 화면이 실제로 바꾸는 필드"만 따로 연다.
      match /participants/{participantId} {
        allow get, list: if hasActiveMemberLink(clubId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // ⚠ 추첨번호↔실제 자리 매핑과 부전승 자리. **관리자 외에는 읽을 수도 없다.**
      // Firestore는 문서를 통째로 내려주고 규칙에 필드 단위 읽기 제어가 없으므로, 이 값이
      // 회원이 읽을 수 있는 곳에 조금이라도 들어가면 현장에서 번호를 뽑기 전에 어느 번호가
      // 부전승인지 알 수 있게 된다. 그래서 아예 별도 컬렉션으로 떼어 놓고 여기서 막는다.
      // (연결된 정상 회원이어도 get·list 모두 거부된다.)
      match /private/{privateDocId} {
        allow read, write: if isAdmin();
      }

      match /matches/{matchId} {
        allow get, list: if hasActiveMemberLink(clubId) || isAdmin();

        // 경기 문서 생성·삭제는 대진 확정·확정 취소뿐이고 둘 다 관리자 작업이다.
        allow create, delete: if isAdmin();

        // 회원이 resultLog에 넣을 수 있는 키. 관리자 감사 필드(verifiedByAdminUid·
        // correctedByAdminUid·approvedByAdminUid·correctedAt·approvedAt)는 일부러 빠져 있다 —
        // 회원이 "관리자가 승인했다"는 기록을 스스로 만들 수 없어야 한다.
        function memberLogKeysOnly() {
          return request.resource.data.resultLog.keys().hasOnly([
            'submittedByMemberId', 'submittedAt', 'correctionRequested',
            'verificationType', 'verifiedByMemberId', 'verifiedAt',
            'correctionRequestedByMemberId', 'correctionRequestedAt'
          ]);
        }

        function changedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        /** 결과를 처음 넣은 사람. 확인·수정요청 단계에서 "나 말고 상대인지" 판단의 기준이다. */
        function submitterMemberId() {
          return resource.data.resultLog.get('submittedByMemberId', '');
        }

        // ① 결과 제출 — 아직 아무도 넣지 않은 정상 경기에 두 선수 중 한 명이 점수를 넣는다.
        //    상태는 반드시 "상대 확인 대기"로만 갈 수 있다(스스로 확정 불가).
        function memberSubmitsResult(me) {
          return resource.data.status == 'awaitingResult'
            && resource.data.resultType == 'normal'
            && changedKeys().hasOnly(['scoreA', 'scoreB', 'calculatedWinnerParticipantId', 'status', 'resultLog'])
            && request.resource.data.status == 'awaitingVerification'
            && request.resource.data.scoreA is int && request.resource.data.scoreA >= 0
            && request.resource.data.scoreB is int && request.resource.data.scoreB >= 0
            && memberLogKeysOnly()
            && request.resource.data.resultLog.submittedByMemberId == me
            && request.resource.data.resultLog.get('correctionRequested', true) == false
            && !('verificationType' in request.resource.data.resultLog);
        }

        // ② 상대 확인 — 결과를 넣지 않은 쪽만 할 수 있다.
        //    ★ 여기가 "한 사람이 입력과 확인을 모두 하는 것"을 서버에서 막는 지점이다.
        //      비교 기준은 memberLinks가 알려주는 memberId다. 같은 회원이 기기(Firebase UID)를
        //      바꿔도 memberId는 같으므로 그대로 거부된다.
        function memberVerifiesResult(me) {
          return resource.data.status == 'awaitingVerification'
            && changedKeys().hasOnly(['status', 'resultLog'])
            && request.resource.data.status == 'awaitingApproval'
            && submitterMemberId() != me
            && memberLogKeysOnly()
            && request.resource.data.resultLog.submittedByMemberId == submitterMemberId()
            && request.resource.data.resultLog.verificationType == 'player'
            && request.resource.data.resultLog.verifiedByMemberId == me
            && request.resource.data.resultLog.get('correctionRequested', true) == false
            && resource.data.resultLog.get('correctionRequested', false) == false;
        }

        // ③ 수정 요청 — 결과를 넣지 않은 쪽만 할 수 있고, 점수·상태는 하나도 못 바꾼다.
        //    회원이 직접 결과를 고치는 길은 어디에도 없다(관리자만 고칠 수 있다).
        function memberRequestsCorrection(me) {
          return resource.data.status == 'awaitingVerification'
            && changedKeys().hasOnly(['resultLog'])
            && submitterMemberId() != me
            && memberLogKeysOnly()
            && request.resource.data.resultLog.submittedByMemberId == submitterMemberId()
            && request.resource.data.resultLog.correctionRequested == true
            && request.resource.data.resultLog.correctionRequestedByMemberId == me
            && !('verificationType' in request.resource.data.resultLog);
        }

        // 공식 확정(official)된 경기는 회원이 어떤 방법으로도 손대지 못한다.
        // 공식 결과 정정은 관리자 절차로만 처리한다.
        function memberMatchUpdate(me) {
          return resource.data.status != 'official'
            && me in [resource.data.playerAMemberId, resource.data.playerBMemberId]
            && (memberSubmitsResult(me) || memberVerifiesResult(me) || memberRequestsCorrection(me));
        }

        // 관리자 쓰기는 다른 컬렉션(ledger·members·sessions 등)과 같은 기준으로 제한 없이 둔다.
        // 관리자 동작은 종류가 많고(승인·직권 확인·수정·기권·다음 라운드 배치) 필드 목록을
        // 규칙에 박아 두면 service가 조금만 바뀌어도 조용히 거부되기 때문이다.
        // 회원 쓰기만 위처럼 엄격히 좁힌다.
        //
        // hasActiveMemberLink는 문서 2회, linkedMemberId는 1회를 읽는다 — 이 규칙 전체에서
        // 문서 접근은 3회뿐이다(관리자 경로는 admins 1회). 조건을 더 얹을 때 이 예산을 넘기지 않도록 주의.
        allow update: if isAdmin()
          || (hasActiveMemberLink(clubId) && memberMatchUpdate(linkedMemberId(clubId)));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
